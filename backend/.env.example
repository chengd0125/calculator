# ============================================
# 批發商業務管理系統 - 環境設定
# 複製此檔案為 .env 並填入實際值
# ============================================

# MS SQL Server 連線設定
DB_SERVER=your_mssql_server_ip
DB_PORT=1433
DB_DATABASE=WholesaleDB
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# 連線加密：預設開啟(true)。Azure SQL 必須加密，正式環境請勿關閉。
# 僅在本機區網自簽憑證的 SQL Server 測試時才設為 false。
DB_ENCRYPT=true
# 是否信任未驗證的伺服器憑證。預設 false，Azure 請保持 false。
DB_TRUST_CERT=false

# JWT 密鑰 (必填，至少32字元；未設定或過短時伺服器將拒絕啟動)
# 產生方式: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_secret_string_at_least_32_chars

# 多廠商（選填）：每間廠商一個資料庫，格式 代號=資料庫名稱，以逗號分隔。
# 前端以 GitHub secret VITE_TENANT 指定代號；沒帶代號的請求使用 DEFAULT_TENANT。
# 未設定時只有一個廠商，使用上面的 DB_DATABASE。
# TENANTS=fupro=WholesaleDB,014test=WholesaleDB_014test
# DEFAULT_TENANT=fupro

# 伺服器連接埠
PORT=3001

# 公司名稱 (列印時顯示)
COMPANY_NAME=您的公司名稱
COMPANY_PHONE=04-XXXXXXXX
COMPANY_ADDRESS=台中市XX區XX路XX號
